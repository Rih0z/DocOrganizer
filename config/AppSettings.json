{
  "AppSettings": {
    "// アプリケーション情報": "DocOrganizer統合設定ファイル",
    "ApplicationInfo": {
      "Name": "DocOrganizer",
      "Version": "3.0.031",
      "Description": "CubePDF Utility互換 汎用PDF編集ツール",
      "Author": "DocOrganizer Development Team",
      "LastUpdated": "2025-09-04"
    },
    
    "// ログ設定": "ログシステムの動作制御",
    "LoggingSettings": {
      "IsEnabled": true,
      "LogDirectory": ".logs",
      "LogFiles": {
        "Debug": "debug.log",
        "Startup": "startup.log",
        "Error": "error.log"
      },
      "LogLevel": "Debug",
      "Rotation": {
        "MaxFileSizeMB": 50,
        "MaxDays": 7,
        "MaxFiles": 10
      },
      "ConsoleOutput": {
        "Enabled": true,
        "ColoredOutput": true
      },
      "Performance": {
        "AsyncWrite": true,
        "BufferSize": 4096,
        "FlushIntervalSeconds": 5
      }
    },
    
    "// UI設定": "ユーザーインターフェース設定",
    "UISettings": {
      "ButtonSizeSettings": {
        "SizeMultiplier": 1.7,
        "BaseButtonSize": 24,
        "BaseButtonPadding": 4,
        "BaseButtonMargin": 1,
        "BaseToolBarHeight": 30,
        "BaseIconFontSize": 10,
        "BaseButtonFontSize": 14,
        "CalculatedButtonSize": 40,
        "CalculatedButtonPadding": 7,
        "CalculatedButtonMargin": 2,
        "CalculatedToolBarHeight": 50,
        "CalculatedIconFontSize": 17,
        "CalculatedButtonFontSize": 24
      },
      "Theme": {
        "ColorScheme": "Light",
        "AccentColor": "#0078D4",
        "FontFamily": "Yu Gothic UI"
      }
    },
    
    "// PDF処理設定": "PDF処理エンジン設定",
    "PdfSettings": {
      "RenderingEngine": "PdfiumViewer",
      "ThumbnailSettings": {
        "Width": 200,
        "Height": 283,
        "Quality": 80,
        "CacheEnabled": true
      },
      "PreviewSettings": {
        "DefaultScale": 3.0,
        "MaxScale": 5.0,
        "MinScale": 0.5
      },
      "PerformanceSettings": {
        "ThumbnailGenerationTimeoutMs": 3000,
        "MaxMemoryUsageMb": 500,
        "EnableParallelProcessing": true
      }
    },
    
    "// ファイル処理設定": "対応ファイル形式と処理設定",
    "FileSettings": {
      "SupportedImageFormats": [
        ".jpg", ".jpeg", ".png", ".gif", ".bmp", 
        ".tiff", ".tif", ".ico", ".webp", ".heic"
      ],
      "SupportedDocumentFormats": [
        ".pdf"
      ],
      "MaxFileSizeMB": 200,
      "TempDirectory": ".temp"
    },
    
    "// 開発設定": "開発・デバッグ用設定",
    "DevelopmentSettings": {
      "DebugMode": false,
      "ShowDeveloperTools": false,
      "EnablePerformanceMonitoring": false,
      "MockDataEnabled": false
    },
    
    "// 環境変数オーバーライド": "環境変数による設定上書き",
    "EnvironmentVariables": {
      "DOCORGANIZER_DEBUG": "LoggingSettings.IsEnabled",
      "DOCORGANIZER_LOG_PATH": "LoggingSettings.LogDirectory",
      "DOCORGANIZER_LOG_LEVEL": "LoggingSettings.LogLevel",
      "DOCORGANIZER_UI_SCALE": "UISettings.ButtonSizeSettings.SizeMultiplier"
    }
  }
}