<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocOrganizer.Application\DocOrganizer.Application.csproj" />
    <ProjectReference Include="..\DocOrganizer.Core\DocOrganizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="PdfiumViewer.Updated" Version="2.14.5" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="IronOcr" Version="2025.1.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Pdfiumネイティブ DLL自動コピー設定 -->
  <Target Name="CopyPdfiumNative" AfterTargets="Build">
    <ItemGroup>
      <PdfiumFiles Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumFiles)" 
          DestinationFolder="$(OutputPath)" 
          SkipUnchangedFiles="true" />
    <Message Text="Pdfium native DLL copied to $(OutputPath)" Importance="high" />
  </Target>

  <!-- 発行時にも確実にコピー -->
  <Target Name="CopyPdfiumOnPublish" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <PdfiumNative Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumNative)" 
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="false" />
    <Message Text="Pdfium native DLL copied to $(PublishDir)" Importance="high" />
  </Target>

</Project>