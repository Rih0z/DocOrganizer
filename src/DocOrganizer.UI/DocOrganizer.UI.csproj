<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- <ApplicationIcon>icon.ico</ApplicationIcon> -->
    <Company>DocOrganizer Project</Company>
    <Product>DocOrganizer</Product>
    <AssemblyName>DocOrganizer</AssemblyName>
    <Version>3.0.068</Version>
    <AssemblyVersion>3.0.068.0</AssemblyVersion>
    <FileVersion>3.0.068.0</FileVersion>
    
    <!-- 単一EXEビルド設定 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- OCR機能の有効/無効制御 -->
    <EnableOCR Condition="'$(EnableOCR)' == ''">false</EnableOCR>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows標準UI用の最小限のパッケージ -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocOrganizer.Application\DocOrganizer.Application.csproj" />
    <ProjectReference Include="..\DocOrganizer.Core\DocOrganizer.Core.csproj" />
    <ProjectReference Include="..\DocOrganizer.Infrastructure\DocOrganizer.Infrastructure.csproj" />
  </ItemGroup>

  <!-- <ItemGroup>
    アイコンとリソース - 現在は画像ファイルなし
    <None Update="Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup> -->

  <!-- pdfium.dllを単一EXEに埋め込む設定 -->
  <ItemGroup>
    <!-- pdfium.dllをEmbeddedResourceとして埋め込む -->
    <EmbeddedResource Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll">
      <LogicalName>pdfium.dll</LogicalName>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="AppSettings.json" />
  </ItemGroup>

  <!-- ビルド時のコピー設定（開発時用） -->
  <Target Name="CopyPdfiumNativeToUI" AfterTargets="Build">
    <ItemGroup>
      <PdfiumFiles Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumFiles)" 
          DestinationFolder="$(OutputPath)" 
          SkipUnchangedFiles="true" />
    <Message Text="Pdfium native DLL copied to UI output: $(OutputPath)" Importance="high" />
  </Target>

  <!-- 単一EXE発行時の設定 -->
  <Target Name="IncludePdfiumInSingleFile" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <!-- pdfium.dllをコンテンツとして含める -->
      <Content Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
    <Message Text="Pdfium native DLL will be included in single file bundle" Importance="high" />
  </Target>

  <!-- OCR関連ファイルのコピー制御 -->
  <Target Name="CleanupOCRFiles" AfterTargets="Publish" Condition="'$(EnableOCR)' != 'true'">
    <ItemGroup>
      <OCRFilesToDelete Include="$(PublishDir)eng.user-words" />
      <OCRFilesToDelete Include="$(PublishDir)eng.user-patterns" />
      <OCRFilesToDelete Include="$(PublishDir)Tesseract.Native.deployment.json" />
      <OCRFilesToDelete Include="$(PublishDir)*.traineddata" />
    </ItemGroup>
    <Delete Files="@(OCRFilesToDelete)" ContinueOnError="true" />
    <Message Text="OCR files removed (OCR disabled)" Importance="high" Condition="'$(EnableOCR)' != 'true'" />
  </Target>

</Project>