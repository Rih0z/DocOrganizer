<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- <ApplicationIcon>icon.ico</ApplicationIcon> -->
    <Company>DocOrganizer Project</Company>
    <Product>DocOrganizer</Product>
    <AssemblyName>DocOrganizer</AssemblyName>
    <Version>3.0.024</Version>
    <AssemblyVersion>3.0.024.0</AssemblyVersion>
    <FileVersion>3.0.024.0</FileVersion>
    
    <!-- 単一EXEビルド設定 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows標準UI用の最小限のパッケージ -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocOrganizer.Application\DocOrganizer.Application.csproj" />
    <ProjectReference Include="..\DocOrganizer.Core\DocOrganizer.Core.csproj" />
    <ProjectReference Include="..\DocOrganizer.Infrastructure\DocOrganizer.Infrastructure.csproj" />
  </ItemGroup>

  <!-- <ItemGroup>
    アイコンとリソース - 現在は画像ファイルなし
    <None Update="Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup> -->

  <!-- Pdfiumネイティブ DLL自動コピー設定 (UI プロジェクト用) -->
  <Target Name="CopyPdfiumNativeToUI" AfterTargets="Build">
    <ItemGroup>
      <PdfiumFiles Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumFiles)" 
          DestinationFolder="$(OutputPath)" 
          SkipUnchangedFiles="true" />
    <Message Text="Pdfium native DLL copied to UI output: $(OutputPath)" Importance="high" />
  </Target>

  <!-- 発行時にも確実にコピー (UI プロジェクト用) -->
  <Target Name="CopyPdfiumOnPublishUI" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <PdfiumNative Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumNative)" 
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="false" />
    <Message Text="Pdfium native DLL copied to publish directory: $(PublishDir)" Importance="high" />
  </Target>

</Project>