<Window x:Class="DocOrganizer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:DocOrganizer.UI.Behaviors"
        mc:Ignorable="d"
        Title="DocOrganizer 3.0.009" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        AllowDrop="True"
        behaviors:V3AdvancedDragDropBehavior.IsDropTarget="True"
        behaviors:V3AdvancedDragDropBehavior.DropHandler="{Binding DragDropHandler}">
    
    <!-- キーボードショートカット -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding DocumentManagement.NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding DocumentManagement.OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding DocumentManagement.SaveCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding PageOperation.SelectAllCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding DocumentManagement.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding DocumentManagement.RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding PageOperation.DeleteSelectedPagesCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
    </Window.InputBindings>

    <!-- Window Resources -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メニューバー -->
        <Menu Grid.Row="0" Background="White">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" Command="{Binding DocumentManagement.NewCommand}" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <TextBlock Text="📄" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="PDF・画像ファイルを開く(_O)..." Command="{Binding DocumentManagement.OpenCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="保存(_S)" Command="{Binding DocumentManagement.SaveCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding DocumentManagement.SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="閉じる(_C)" Command="{Binding DocumentManagement.CloseCommand}"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Command="{Binding DocumentManagement.ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="やり直し(_R)" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="すべて選択(_A)" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <MenuItem Header="選択解除(_D)" Command="{Binding DeselectAllCommand}"/>
            </MenuItem>
            
            <MenuItem Header="ページ(_P)">
                <MenuItem Header="左回転(_L)" Command="{Binding PageOperation.RotateLeftCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="↺" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="右回転(_R)" Command="{Binding PageOperation.RotateRightCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="↻" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="全ページ自動回転(_A)" Command="{Binding PageOperation.AutoCorrectAllPagesOrientationCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📖" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="ページ削除(_D)" Command="{Binding PageOperation.DeleteSelectedPagesCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🗑️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="ページ移動(_M)">
                    <MenuItem Header="上に移動(_U)" Command="{Binding PageOperation.MovePageUpCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="⬆️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="下に移動(_D)" Command="{Binding PageOperation.MovePageDownCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="⬇️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </MenuItem>

            <!-- 🆕 PDF編集メニュー -->
            <MenuItem Header="PDF編集(_P)" Visibility="{Binding DocumentManagement.IsPdfDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="PDF分割(_S)..." Command="{Binding DocumentManagement.SplitPdfCommand}" IsEnabled="{Binding DocumentManagement.CanSplitPdf}">
                    <MenuItem.Icon>
                        <TextBlock Text="📄➗" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="PDF結合(_M)..." Command="{Binding DocumentManagement.MergePdfCommand}" IsEnabled="{Binding DocumentManagement.CanMergePdf}">
                    <MenuItem.Icon>
                        <TextBlock Text="📄➕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="削除(_D)" Command="{Binding PageOperation.DeleteSelectedPagesCommand}" InputGestureText="Delete">
                    <MenuItem.Icon>
                        <TextBlock Text="🗑" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="上に移動(_U)" Command="{Binding PageOperation.MovePageUpCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="▲" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="下に移動(_N)" Command="{Binding PageOperation.MovePageDownCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="▼" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            
            <MenuItem Header="文書(_D)">
                <MenuItem Header="結合(_M)..." Command="{Binding MergeCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="分割(_S)..." Command="{Binding SplitCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="✂" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="セキュリティ設定(_E)..." Command="{Binding SecurityCommand}"/>
            </MenuItem>
            
            <MenuItem Header="表示(_V)">
                <MenuItem Header="拡大(_I)" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++"/>
                <MenuItem Header="縮小(_O)" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="全体表示(_F)" Command="{Binding FitToWindowCommand}"/>
                <Separator/>
                <MenuItem Header="サムネイルサイズ(_T)">
                    <MenuItem Header="小" Command="{Binding ThumbnailSmallCommand}" IsCheckable="True"/>
                    <MenuItem Header="中" Command="{Binding ThumbnailMediumCommand}" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="大" Command="{Binding ThumbnailLargeCommand}" IsCheckable="True"/>
                </MenuItem>
            </MenuItem>
            
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="ヘルプの表示(_H)" Command="{Binding ShowHelpCommand}" InputGestureText="F1"/>
                <Separator/>
                <MenuItem Header="アップデートの確認(_U)..." Command="{Binding CheckForUpdatesCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="バージョン情報(_A)..." Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ツールバー -->
        <ToolBarTray Grid.Row="1" Background="White">
            <ToolBar x:Name="MainToolBar" Background="Transparent">
                <!-- ファイル操作ボタンは削除済み -->
                
                <!-- ページ操作 -->
                <Button Command="{Binding PageOperation.RotateLeftCommand}" ToolTip="左回転" Padding="4"
                        IsEnabled="{Binding PageOperation.HasSelectedPages}">
                    <TextBlock Text="↺" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding PageOperation.RotateRightCommand}" ToolTip="右回転" Padding="4"
                        IsEnabled="{Binding PageOperation.HasSelectedPages}">
                    <TextBlock Text="↻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding PageOperation.DeleteSelectedPagesCommand}" ToolTip="削除 (Delete)" Padding="4"
                        IsEnabled="{Binding PageOperation.HasSelectedPages}">
                    <TextBlock Text="🗑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                
                <Separator/>
                
                <!-- ページ移動 -->
                <Button Command="{Binding PageOperation.MovePageUpCommand}" ToolTip="上に移動" Padding="4"
                        IsEnabled="{Binding PageOperation.CanMoveUp}">
                    <TextBlock Text="▲" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding PageOperation.MovePageDownCommand}" ToolTip="下に移動" Padding="4"
                        IsEnabled="{Binding PageOperation.CanMoveDown}">
                    <TextBlock Text="▼" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                
                <!-- 📖 全ページ自動回転ボタン -->
                <Button Command="{Binding PageOperation.AutoCorrectAllPagesOrientationCommand}" ToolTip="全ページの文字向きを自動補正" Padding="6,4"
                        IsEnabled="{Binding DocumentManagement.HasDocument}" Background="#E3F2FD" BorderBrush="#1976D2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📖" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="自動回転" FontSize="11" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                </Button>
                <Separator/>
                
                <!-- 表示 -->
                <Button Command="{Binding ZoomInCommand}" ToolTip="拡大" Padding="4">
                    <TextBlock Text="🔍+" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding ZoomOutCommand}" ToolTip="縮小" Padding="4">
                    <TextBlock Text="🔍-" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <ComboBox Width="80" SelectedItem="{Binding PreviewManagement.ZoomLevel}" Margin="4,0">
                    <ComboBoxItem>50%</ComboBoxItem>
                    <ComboBoxItem>75%</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">100%</ComboBoxItem>
                    <ComboBoxItem>125%</ComboBoxItem>
                    <ComboBoxItem>150%</ComboBoxItem>
                    <ComboBoxItem>200%</ComboBoxItem>
                </ComboBox>
                
                <Separator/>
                
                <!-- 🎯 V3.0新機能: PDF出力 -->
                <Button Command="{Binding ExportPdfCommand}" ToolTip="PDFとして保存" Padding="8,6"
                        IsEnabled="{Binding CanExportPdf}"
                        Background="#E8F5E8" BorderBrush="#4CAF50" BorderThickness="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="PDF出力" FontSize="12" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Button>
                
                <!-- 画質選択 -->
                <ComboBox Width="120" SelectedItem="{Binding SelectedQuality}" Margin="4,0" ToolTip="PDF出力画質選択"
                          ItemsSource="{Binding QualityOptions}" DisplayMemberPath="DisplayName"/>
                          
                <Separator/>
                
                <!-- キーボードショートカット表示 -->
                <TextBlock Text="Ctrl+S: 保存 | Ctrl+O: 開く | Delete: 削除" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="8,0"/>
            </ToolBar>
            
            <!-- 🆕 PDF編集専用ツールバー -->
            <ToolBar x:Name="PdfEditingToolBar" Background="Transparent" 
                     Visibility="{Binding DocumentManagement.IsPdfDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                
                <!-- PDF分割ボタン -->
                <Button Command="{Binding DocumentManagement.SplitPdfCommand}" ToolTip="PDF分割" Padding="6,4"
                        IsEnabled="{Binding DocumentManagement.CanSplitPdf}" Background="#FFF3E0" BorderBrush="#FF9800">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄➗" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="分割" FontSize="11" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF9800"/>
                    </StackPanel>
                </Button>
                
                <!-- PDF結合ボタン -->
                <Button Command="{Binding DocumentManagement.MergePdfCommand}" ToolTip="PDF結合" Padding="6,4"
                        IsEnabled="{Binding DocumentManagement.CanMergePdf}" Background="#E8F5E8" BorderBrush="#4CAF50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄➕" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="結合" FontSize="11" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </Button>
                
                <Separator/>
                
                <!-- PDF編集情報表示 -->
                <TextBlock Text="PDF編集モード" FontSize="11" FontWeight="Bold" Foreground="#1976D2" 
                           VerticalAlignment="Center" Margin="8,0"/>
                
            </ToolBar>
            
            <!-- 🆕 HEIC/GIF対応表示ツールバー -->
            <ToolBar x:Name="FormatSupportToolBar" Background="Transparent"
                     Visibility="{Binding DocumentManagement.HasHeicFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                
                <!-- HEIC対応表示 -->
                <Border Background="#F3E5F5" BorderBrush="#9C27B0" BorderThickness="1" CornerRadius="3" Padding="4,2"
                        Visibility="{Binding DocumentManagement.HasHeicFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📱" FontSize="12" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock Text="HEIC対応" FontSize="10" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9C27B0"/>
                    </StackPanel>
                </Border>
                
                <!-- GIF対応表示 -->
                <Border Background="#E1F5FE" BorderBrush="#03A9F4" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="4,0,0,0"
                        Visibility="{Binding DocumentManagement.HasGifFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎞️" FontSize="12" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock Text="GIF対応" FontSize="10" VerticalAlignment="Center" FontWeight="Bold" Foreground="#03A9F4"/>
                    </StackPanel>
                </Border>
                
            </ToolBar>
        </ToolBarTray>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：ページサムネイル -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- サムネイルヘッダー -->
                    <Border Grid.Row="0" Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                        <Grid Height="24">
                            <TextBlock Text="ページ" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DocumentManagement.PageCountText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0"/>
                        </Grid>
                    </Border>

                    <!-- サムネイルリスト -->
                    <ListBox Grid.Row="1" 
                             x:Name="PageListBox"
                             ItemsSource="{Binding Pages}"
                             Background="White"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Extended"
                             AllowDrop="True"
                             SelectionChanged="PageListBox_SelectionChanged"
                             IsSynchronizedWithCurrentItem="True"
                             behaviors:V3AdvancedDragDropBehavior.IsDragSource="True"
                             behaviors:V3AdvancedDragDropBehavior.IsDropTarget="True"
                             behaviors:V3AdvancedDragDropBehavior.DragHandler="{Binding DragDropHandler}"
                             behaviors:V3AdvancedDragDropBehavior.DropHandler="{Binding DragDropHandler}">
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3399FF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="120"/>
                                        </Grid.RowDefinitions>

                                        <!-- ページ番号 -->
                                        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding PageNumber, StringFormat='{}{0}'}" 
                                                       HorizontalAlignment="Center" 
                                                       Margin="4,2"
                                                       FontSize="11"/>
                                        </Border>

                                        <!-- サムネイル画像 -->
                                        <Border Grid.Row="1" Background="White" Margin="4">
                                            <Image Source="{Binding ThumbnailImage}" 
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- スプリッター -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="#CCCCCC"
                          ShowsPreview="False"/>

            <!-- 右側：プレビューエリア -->
            <Border Grid.Column="2" Background="#808080"
                    AllowDrop="True"
                    behaviors:V3AdvancedDragDropBehavior.IsDropTarget="True"
                    behaviors:V3AdvancedDragDropBehavior.DropHandler="{Binding DragDropHandler}">
                <Grid>
                    <!-- プレビュー表示 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#808080"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                        <Border Background="White" 
                                Margin="20"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Image Source="{Binding PreviewManagement.CurrentPageImage}" 
                                   Stretch="Uniform"
                                   MaxWidth="{Binding PreviewManagement.PreviewWidth}"
                                   MaxHeight="{Binding PreviewManagement.PreviewHeight}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </ScrollViewer>

                    <!-- ドラッグ&ドロップオーバーレイ -->
                    <Border x:Name="DropOverlay"
                            Background="#80000000" 
                            Visibility="Collapsed"
                            AllowDrop="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="ここにPDFまたは画像ファイルをドロップ" 
                                       Foreground="White" 
                                       FontSize="20" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="(PDF, HEIC, JPG, PNG, JPEG対応)" 
                                       Foreground="#CCFFFFFF" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 空の状態表示 -->
                    <Border Visibility="{Binding PreviewManagement.EmptyStateVisibility}" Background="White"
                            AllowDrop="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="PDFまたは画像ファイルを開いてください" 
                                       Foreground="#666666" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="ここにドラッグ&amp;ドロップ" 
                                       Foreground="#666666" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <Border Background="#E3F2FD" 
                                    BorderBrush="#1976D2" 
                                    BorderThickness="2" 
                                    CornerRadius="8" 
                                    Padding="16,8" 
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="対応形式:" 
                                               Foreground="#1976D2" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="PDF, HEIC, JPG, PNG, JPEG" 
                                               Foreground="#1976D2" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="画像ファイルは自動的にPDFに変換されます" 
                                               Foreground="#1976D2" 
                                               FontSize="12" 
                                               HorizontalAlignment="Center" 
                                               FontStyle="Italic"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="3" Background="#F0F0F0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusManagement.StatusMessage}"/>
            </StatusBarItem>
            
            <StatusBarItem Grid.Column="1">
                <Grid>
                    <!-- 通常処理用プログレスバー -->
                    <ProgressBar Width="150" Height="16" 
                                 Value="{Binding StatusManagement.ProgressValue}" 
                                 Visibility="{Binding StatusManagement.ProgressVisibility}"/>
                    <!-- PDF出力用プログレスバー -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Width="120" Height="16" Value="{Binding ExportProgress}" Maximum="100"/>
                        <TextBlock Text="{Binding ExportStatusMessage}" Margin="8,0" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </StatusBarItem>
            
            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding DocumentManagement.PageInfo}" Margin="8,0"/>
            </StatusBarItem>
            
            <StatusBarItem Grid.Column="3">
                <TextBlock Text="{Binding DocumentManagement.FileInfo}" Margin="8,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>