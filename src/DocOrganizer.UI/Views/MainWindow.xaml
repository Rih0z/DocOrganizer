<Window x:Class="DocOrganizer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:DocOrganizer.UI.Behaviors"
        mc:Ignorable="d"
        Title="DocOrganizer 3.0.071" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        AllowDrop="True"
        behaviors:V3AdvancedDragDropBehavior.IsDropTarget="True"
        behaviors:V3AdvancedDragDropBehavior.DropHandler="{Binding DragDropHandler}"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <!-- キーボードショートカット完全実装 V3.0.065 -->
    <Window.InputBindings>
        <!-- ファイル操作 -->
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding DocumentManagement.NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding DocumentManagement.OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding DocumentManagement.SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding DocumentManagement.SaveAsCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding DocumentManagement.CloseCommand}"/>
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{Binding DocumentManagement.ExitCommand}"/>
        <KeyBinding Key="F4" Modifiers="Alt" Command="{Binding DocumentManagement.ExitCommand}"/>
        
        <!-- 編集操作 -->
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding DocumentManagement.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding DocumentManagement.RedoCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding PageOperation.SelectAllCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl+Shift" Command="{Binding PageOperation.DeselectAllCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding PageOperation.DeleteSelectedPagesCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding PageOperation.DeleteSelectedPagesCommand}"/>
        
        <!-- ページ操作 (CubePDF方式) -->
        <!-- 回転: Ctrl+L/R (CubePDF互換) -->
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding PageOperation.RotateLeftCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding PageOperation.RotateRightCommand}"/>
        <!-- 移動: Ctrl+B/F (CubePDF互換) -->
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding PageOperation.MovePageUpCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding PageOperation.MovePageDownCommand}"/>
        <!-- 代替ショートカット (互換性維持) -->
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PageOperation.RotateLeftCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding PageOperation.RotateRightCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding PageOperation.MovePageUpCommand}"/>
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding PageOperation.MovePageDownCommand}"/>
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding PageOperation.GoToPageCommand}"/>
        <KeyBinding Key="PageUp" Command="{Binding PageOperation.PreviousPageCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding PageOperation.NextPageCommand}"/>
        <KeyBinding Key="Home" Command="{Binding PageOperation.FirstPageCommand}"/>
        <KeyBinding Key="End" Command="{Binding PageOperation.LastPageCommand}"/>
        
        <!-- PDF編集操作 -->
        <KeyBinding Key="M" Modifiers="Ctrl+Shift" Command="{Binding DocumentManagement.MergePdfCommand}"/>
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding DocumentManagement.SplitPdfCommand}"/>
        
        <!-- ファイル追加操作 -->
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding DocumentManagement.AddImageCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding DocumentManagement.AddFilesCommand}"/>
        
        <!-- 表示操作 -->
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding PreviewManagement.ZoomInCommand}"/>
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding PreviewManagement.ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding PreviewManagement.ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding PreviewManagement.ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding PreviewManagement.FitToWindowCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{Binding PreviewManagement.FitToWindowCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding PreviewManagement.FullScreenCommand}"/>
        <KeyBinding Key="F11" Command="{Binding PreviewManagement.FullScreenCommand}"/>
        
        <!-- ヘルプ操作 -->
        <KeyBinding Key="F1" Command="{Binding PageOperation.ShowHelpCommand}"/>
        <!-- F1キーの代替ショートカット（Windowsシステムによる横取り対策） -->
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding PageOperation.ShowHelpCommand}"/>
        <KeyBinding Key="F1" Modifiers="Alt" Command="{Binding PageOperation.ShowHelpCommand}"/>
        <KeyBinding Key="F1" Modifiers="Shift" Command="{Binding PageOperation.ShowHelpCommand}"/>
        <KeyBinding Key="OemQuestion" Modifiers="Ctrl+Shift" Command="{Binding PageOperation.ShowHelpCommand}"/>
        
        <!-- その他の操作 -->
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FindCommand}"/>
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}"/>
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPreviousCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <!-- Window Resources -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メニューバー -->
        <Menu Grid.Row="0" Background="White">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" Command="{Binding DocumentManagement.NewCommand}" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <TextBlock Text="📄" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="PDF・画像ファイルを開く(_O)..." Command="{Binding DocumentManagement.OpenCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="保存(_S)" Command="{Binding DocumentManagement.SaveCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding DocumentManagement.SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="閉じる(_C)" Command="{Binding DocumentManagement.CloseCommand}" InputGestureText="Ctrl+W"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Command="{Binding DocumentManagement.ExitCommand}" InputGestureText="Ctrl+Q / Alt+F4"/>
            </MenuItem>
            
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="やり直し(_R)" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="すべて選択(_A)" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <MenuItem Header="選択解除(_D)" Command="{Binding DeselectAllCommand}" InputGestureText="Ctrl+Shift+D"/>
            </MenuItem>
            
            <MenuItem Header="ページ(_P)">
                <MenuItem Header="左回転(_L)" Command="{Binding PageOperation.RotateLeftCommand}" InputGestureText="Ctrl+Shift+←">
                    <MenuItem.Icon>
                        <Viewbox Width="32" Height="32">
                            <TextBlock Text="↺" FontSize="30"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="右回転(_R)" Command="{Binding PageOperation.RotateRightCommand}" InputGestureText="Ctrl+Shift+→">
                    <MenuItem.Icon>
                        <Viewbox Width="32" Height="32">
                            <TextBlock Text="↻" FontSize="30"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="全ページ自動回転(_A)" Command="{Binding PageOperation.AutoCorrectAllPagesOrientationCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📖" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="ページ削除(_D)" Command="{Binding PageOperation.DeleteSelectedPagesCommand}" InputGestureText="Delete / Ctrl+D">
                    <MenuItem.Icon>
                        <Viewbox Width="32" Height="32">
                            <TextBlock Text="🗑️" FontSize="30"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="ページ移動(_M)">
                    <MenuItem Header="上に移動(_U)" Command="{Binding PageOperation.MovePageUpCommand}" InputGestureText="Ctrl+Shift+↑">
                        <MenuItem.Icon>
                            <TextBlock Text="⬆️" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="下に移動(_D)" Command="{Binding PageOperation.MovePageDownCommand}" InputGestureText="Ctrl+Shift+↓">
                        <MenuItem.Icon>
                            <TextBlock Text="⬇️" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </MenuItem>

            <!-- 🆕 PDF編集メニュー -->
            <MenuItem Header="PDF編集(_P)" Visibility="{Binding DocumentManagement.IsPdfDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="PDF分割(_S)..." Command="{Binding DocumentManagement.SplitPdfCommand}" IsEnabled="{Binding DocumentManagement.CanSplitPdf}" InputGestureText="Ctrl+Shift+P">
                    <MenuItem.Icon>
                        <TextBlock Text="📄➗" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="PDF結合(_M)..." Command="{Binding DocumentManagement.MergePdfCommand}" IsEnabled="{Binding DocumentManagement.CanMergePdf}" InputGestureText="Ctrl+Shift+M">
                    <MenuItem.Icon>
                        <TextBlock Text="📄➕" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="削除(_D)" Command="{Binding PageOperation.DeleteSelectedPagesCommand}" InputGestureText="Delete">
                    <MenuItem.Icon>
                        <Viewbox Width="32" Height="32">
                            <TextBlock Text="🗑" FontSize="30"/>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="上に移動(_U)" Command="{Binding PageOperation.MovePageUpCommand}" InputGestureText="Alt+U">
                    <MenuItem.Icon>
                        <TextBlock Text="▲" Style="{StaticResource MenuIconStyle}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="下に移動(_N)" Command="{Binding PageOperation.MovePageDownCommand}" InputGestureText="Alt+D">
                    <MenuItem.Icon>
                        <TextBlock Text="▼" Style="{StaticResource MenuIconStyle}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            
            <MenuItem Header="文書(_D)">
                <MenuItem Header="結合(_M)..." Command="{Binding MergeCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="分割(_S)..." Command="{Binding SplitCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="✂" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="セキュリティ設定(_E)..." Command="{Binding SecurityCommand}"/>
            </MenuItem>
            
            <MenuItem Header="表示(_V)">
                <MenuItem Header="拡大(_I)" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++"/>
                <MenuItem Header="縮小(_O)" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="全体表示(_F)" Command="{Binding FitToWindowCommand}" InputGestureText="Ctrl+0"/>
                <Separator/>
                <MenuItem Header="サムネイルサイズ(_T)">
                    <MenuItem Header="小" Command="{Binding ThumbnailSmallCommand}" IsCheckable="True"/>
                    <MenuItem Header="中" Command="{Binding ThumbnailMediumCommand}" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="大" Command="{Binding ThumbnailLargeCommand}" IsCheckable="True"/>
                </MenuItem>
            </MenuItem>
            
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="ヘルプの表示(_H)" Command="{Binding PageOperation.ShowHelpCommand}" InputGestureText="Ctrl+H (F1)"/>
                <Separator/>
                <MenuItem Header="アップデートの確認(_U)..." Command="{Binding CheckForUpdatesCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="バージョン情報(_A)..." Command="{Binding AboutCommand}"/>
            </MenuItem>
            
            <!-- デバッグ用テストメニュー（リリース時は削除） -->
            <MenuItem Header="テスト(_T)">
                <MenuItem Header="エラーダイアログテスト" Command="{Binding PageOperation.TestErrorDialogCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="❌" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="警告ダイアログテスト" Command="{Binding PageOperation.TestWarningDialogCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="⚠️" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="確認ダイアログテスト" Command="{Binding PageOperation.TestConfirmationDialogCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="❓" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="入力ダイアログテスト" Command="{Binding PageOperation.TestInputDialogCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📝" Style="{StaticResource MenuIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ツールバー -->
        <ToolBarTray Grid.Row="1" Background="White">
            <ToolBar x:Name="MainToolBar" Style="{StaticResource MainToolBarStyle}">
                <!-- ファイル操作ボタンは削除済み -->
                
                <!-- ページ操作 -->
                <Button Command="{Binding PageOperation.RotateLeftCommand}" ToolTip="左回転" Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding PageOperation.HasSelectedPages}">
                    <TextBlock Text="↺" Style="{StaticResource ToolBarButtonIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding PageOperation.RotateRightCommand}" ToolTip="右回転" Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding PageOperation.HasSelectedPages}">
                    <TextBlock Text="↻" Style="{StaticResource ToolBarButtonIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding PageOperation.DeleteSelectedPagesCommand}" ToolTip="削除 (Delete)" Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding PageOperation.HasSelectedPages}">
                    <TextBlock Text="🗑" Style="{StaticResource ToolBarButtonIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                
                <Separator/>
                
                <!-- ページ移動 -->
                <Button Command="{Binding PageOperation.MovePageUpCommand}" ToolTip="上に移動" Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding PageOperation.CanMoveUp}">
                    <TextBlock Text="▲" Style="{StaticResource ToolBarButtonIconStyle}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding PageOperation.MovePageDownCommand}" ToolTip="下に移動" Style="{StaticResource ToolBarButtonStyle}"
                        IsEnabled="{Binding PageOperation.CanMoveDown}">
                    <TextBlock Text="▼" Style="{StaticResource ToolBarButtonIconStyle}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                
                <!-- 📖 全ページ自動回転ボタン -->
                <Button Command="{Binding PageOperation.AutoCorrectAllPagesOrientationCommand}" ToolTip="全ページの文字向きを自動補正" Style="{StaticResource ToolBarWideButtonStyle}"
                        IsEnabled="{Binding DocumentManagement.HasDocument}" Background="#E3F2FD" BorderBrush="#1976D2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📖" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="自動回転" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                </Button>
                <Separator/>
                
                <!-- 表示 -->
                <Button Command="{Binding ZoomInCommand}" ToolTip="拡大" Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="🔍+" Style="{StaticResource ToolBarButtonIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding ZoomOutCommand}" ToolTip="縮小" Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="🔍-" Style="{StaticResource ToolBarButtonIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <ComboBox Width="80" 
                          Text="{Binding PreviewManagement.ZoomLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" Margin="4,0">
                    <ComboBoxItem Content="25%"/>
                    <ComboBoxItem Content="50%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="100%"/>
                    <ComboBoxItem Content="125%"/>
                    <ComboBoxItem Content="150%"/>
                    <ComboBoxItem Content="200%"/>
                </ComboBox>
                
                <Separator/>
                
                <!-- 🎯 V3.0新機能: PDF出力 -->
                <Button Command="{Binding ExportPdfCommand}" ToolTip="PDFとして保存" Padding="24,18" Margin="4,0" MinWidth="180" MinHeight="72"
                        IsEnabled="{Binding CanExportPdf}"
                        Background="#E8F5E8" BorderBrush="#4CAF50" BorderThickness="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <TextBlock Text="PDF出力" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Button>
                
                <!-- 画質選択 -->
                <ComboBox Width="120" SelectedItem="{Binding SelectedQuality}" Margin="4,0" ToolTip="PDF出力画質選択"
                          ItemsSource="{Binding QualityOptions}" DisplayMemberPath="DisplayName"/>
                          
                <Separator/>
                
                <!-- キーボードショートカット表示 -->
                <TextBlock Text="Ctrl+S: 保存 | Ctrl+O: 開く | Delete: 削除" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="8,0"/>
            </ToolBar>
            
            <!-- 🆕 PDF編集専用ツールバー -->
            <ToolBar x:Name="PdfEditingToolBar" Background="Transparent" 
                     Visibility="{Binding DocumentManagement.IsPdfDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                
                <!-- PDF分割ボタン -->
                <Button Command="{Binding DocumentManagement.SplitPdfCommand}" ToolTip="PDF分割" Style="{StaticResource ToolBarWideButtonStyle}"
                        IsEnabled="{Binding DocumentManagement.CanSplitPdf}" Background="#FFF3E0" BorderBrush="#FF9800">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄➗" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="分割" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF9800"/>
                    </StackPanel>
                </Button>
                
                <!-- PDF結合ボタン -->
                <Button Command="{Binding DocumentManagement.MergePdfCommand}" ToolTip="PDF結合" Style="{StaticResource ToolBarWideButtonStyle}"
                        IsEnabled="{Binding DocumentManagement.CanMergePdf}" Background="#E8F5E8" BorderBrush="#4CAF50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄➕" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="結合" Style="{StaticResource ToolBarButtonIconStyle}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </Button>
                
                <Separator/>
                
                <!-- PDF編集情報表示 -->
                <TextBlock Text="PDF編集モード" FontSize="11" FontWeight="Bold" Foreground="#1976D2" 
                           VerticalAlignment="Center" Margin="8,0"/>
                
            </ToolBar>
            
            <!-- 🆕 HEIC/GIF対応表示ツールバー -->
            <ToolBar x:Name="FormatSupportToolBar" Background="Transparent"
                     Visibility="{Binding DocumentManagement.HasHeicFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                
                <!-- HEIC対応表示 -->
                <Border Background="#F3E5F5" BorderBrush="#9C27B0" BorderThickness="1" CornerRadius="3" Padding="4,2"
                        Visibility="{Binding DocumentManagement.HasHeicFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📱" Style="{StaticResource MenuIconStyle}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock Text="HEIC対応" FontSize="10" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9C27B0"/>
                    </StackPanel>
                </Border>
                
                <!-- GIF対応表示 -->
                <Border Background="#E1F5FE" BorderBrush="#03A9F4" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="4,0,0,0"
                        Visibility="{Binding DocumentManagement.HasGifFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎞️" Style="{StaticResource MenuIconStyle}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock Text="GIF対応" FontSize="10" VerticalAlignment="Center" FontWeight="Bold" Foreground="#03A9F4"/>
                    </StackPanel>
                </Border>
                
            </ToolBar>
        </ToolBarTray>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：ページサムネイル -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- サムネイルヘッダー -->
                    <Border Grid.Row="0" Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="ページ" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"/>
                            
                            <!-- 選択状態表示 -->
                            <Border Grid.Column="1" Margin="4,2" Padding="4,2" CornerRadius="3" HorizontalAlignment="Center"
                                    Visibility="{Binding PageOperation.HasSelectedPages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PageOperation.IsAllPagesSelected}" Value="True">
                                                <Setter Property="Background" Value="#0078D4"/>
                                                <Setter Property="BorderBrush" Value="#0066B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#0078D4"/>
                                            <Setter Property="Text" Value="{Binding PageOperation.SelectedPagesCount, StringFormat='{}{0}ページ選択'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PageOperation.IsAllPagesSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Text" Value="全選択中"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            
                            <TextBlock Grid.Column="2" Text="{Binding DocumentManagement.PageCountText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0"/>
                        </Grid>
                    </Border>

                    <!-- サムネイルリスト -->
                    <ListBox Grid.Row="1" 
                             x:Name="PageListBox"
                             ItemsSource="{Binding Pages}"
                             Background="White"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Extended"
                             AllowDrop="True"
                             SelectionChanged="PageListBox_SelectionChanged"
                             behaviors:V3AdvancedDragDropBehavior.IsDragSource="True"
                             behaviors:V3AdvancedDragDropBehavior.IsDropTarget="True"
                             behaviors:V3AdvancedDragDropBehavior.DragHandler="{Binding DragDropHandler}"
                             behaviors:V3AdvancedDragDropBehavior.DropHandler="{Binding DragDropHandler}">
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <!-- ControlTemplateで完全制御し、選択時の視覚的フィードバックを強化 -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Name="Border" 
                                                    Background="White" 
                                                    BorderBrush="#CCCCCC" 
                                                    BorderThickness="1"
                                                    Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 選択状態の強調表示 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                                                    <Setter TargetName="Border" Property="BorderThickness" Value="3"/>
                                                    <Setter TargetName="Border" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#E6F3FF" Offset="0"/>
                                                                <GradientStop Color="#CCE4F7" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <!-- 選択時の影効果 -->
                                                    <Setter TargetName="Border" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" 
                                                                            ShadowDepth="2" 
                                                                            Color="#400078D4"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <!-- ホバー時のハイライト -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#808080"/>
                                                    <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                                <!-- 選択+ホバー時の強調 -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#005A9E"/>
                                                    <Setter TargetName="Border" Property="BorderThickness" Value="3"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#0078D4"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                    <Setter Property="Background" Value="#CCE4F7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="120"/>
                                        </Grid.RowDefinitions>

                                        <!-- ページ番号 -->
                                        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#3399FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PageNumber, StringFormat='{}{0}'}" 
                                                       HorizontalAlignment="Center" 
                                                       Margin="4,2"
                                                       FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Black"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- サムネイル画像 -->
                                        <Grid Grid.Row="1">
                                            <Border Background="White" Margin="4">
                                                <Image Source="{Binding ThumbnailImage}" 
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.85"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Border>
                                            <!-- 選択時のオーバーレイ -->
                                            <Border Margin="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <SolidColorBrush Color="#0078D4" Opacity="0.15"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- スプリッター -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="#CCCCCC"
                          ShowsPreview="False"/>

            <!-- 右側：プレビューエリア -->
            <Border Grid.Column="2" Background="#808080"
                    AllowDrop="True"
                    behaviors:V3AdvancedDragDropBehavior.IsDropTarget="True"
                    behaviors:V3AdvancedDragDropBehavior.DropHandler="{Binding DragDropHandler}">
                <Grid>
                    <!-- プレビュー表示 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#808080"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                        <Border Background="White" 
                                Margin="20"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Image Source="{Binding PreviewManagement.CurrentPageImage}" 
                                   Stretch="Uniform"
                                   Width="{Binding PreviewManagement.PreviewWidth}"
                                   Height="{Binding PreviewManagement.PreviewHeight}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </ScrollViewer>

                    <!-- ドラッグ&ドロップオーバーレイ -->
                    <Border x:Name="DropOverlay"
                            Background="#80000000" 
                            Visibility="Collapsed"
                            AllowDrop="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="ここにPDFまたは画像ファイルをドロップ" 
                                       Foreground="White" 
                                       Style="{StaticResource MenuIconStyle}" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="(PDF, HEIC, JPG, PNG, JPEG対応)" 
                                       Foreground="#CCFFFFFF" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 空の状態表示 -->
                    <Border Visibility="{Binding PreviewManagement.EmptyStateVisibility}" Background="White"
                            AllowDrop="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="PDFまたは画像ファイルを開いてください" 
                                       Foreground="#666666" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="ここにドラッグ&amp;ドロップ" 
                                       Foreground="#666666" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <Border Background="#E3F2FD" 
                                    BorderBrush="#1976D2" 
                                    BorderThickness="2" 
                                    CornerRadius="8" 
                                    Padding="16,8" 
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="対応形式:" 
                                               Foreground="#1976D2" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="PDF, HEIC, JPG, PNG, JPEG" 
                                               Foreground="#1976D2" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="画像ファイルは自動的にPDFに変換されます" 
                                               Foreground="#1976D2" 
                                               Style="{StaticResource MenuIconStyle}" 
                                               HorizontalAlignment="Center" 
                                               FontStyle="Italic"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="3" Background="#F0F0F0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusManagement.StatusMessage}"/>
            </StatusBarItem>
            
            <StatusBarItem Grid.Column="1">
                <Grid>
                    <!-- 通常処理用プログレスバー -->
                    <ProgressBar Width="150" Height="16" 
                                 Value="{Binding StatusManagement.ProgressValue}" 
                                 Visibility="{Binding StatusManagement.ProgressVisibility}"/>
                    <!-- PDF出力用プログレスバー -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Width="120" Height="16" Value="{Binding ExportProgress}" Maximum="100"/>
                        <TextBlock Text="{Binding ExportStatusMessage}" Margin="8,0" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </StatusBarItem>
            
            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding DocumentManagement.PageInfo}" Margin="8,0"/>
            </StatusBarItem>
            
            <StatusBarItem Grid.Column="3">
                <TextBlock Text="{Binding DocumentManagement.FileInfo}" Margin="8,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>