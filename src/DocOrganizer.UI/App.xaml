<Application x:Class="DocOrganizer.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ボタンサイズ設定（config\ButtonSizeSettings.jsonで倍率調整可能） -->
        <!-- 標準サイズ: 1.0倍 = 24x24px, 1.7倍 = 40x40px, 2.0倍 = 48x48px, 3.0倍 = 72x72px -->
        
        <!-- スタイルは起動時にApp.xaml.csで動的に作成されます -->
        <!-- 設定値はAppSettings.jsonのUISettings.ButtonSizeSettingsから読み込まれます -->
        
        <!-- Windows標準スタイル（既存） -->
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="MinHeight" Value="23"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        
        <Style TargetType="ToolBar">
            <Setter Property="ToolBarTray.IsLocked" Value="True"/>
        </Style>
    </Application.Resources>
</Application>