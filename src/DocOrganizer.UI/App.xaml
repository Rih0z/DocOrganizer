<Application x:Class="DocOrganizer.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ボタンサイズ設定（config\ButtonSizeSettings.jsonで倍率調整可能） -->
        <!-- 標準サイズ: 1.0倍 = 24x24px, 1.7倍 = 40x40px, 2.0倍 = 48x48px, 3.0倍 = 72x72px -->
        
        <!-- ツールバーボタン用スタイル（倍率1.7） -->
        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        
        <!-- ツールバーボタン内のテキスト用スタイル -->
        <Style x:Key="ToolBarButtonIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- 複合ボタン用スタイル（幅広） -->
        <Style x:Key="ToolBarWideButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        
        <!-- ツールバー用スタイル -->
        <Style x:Key="MainToolBarStyle" TargetType="ToolBar">
            <Setter Property="Height" Value="50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolBarTray.IsLocked" Value="True"/>
        </Style>
        
        <!-- メニューアイコン用スタイル -->
        <Style x:Key="MenuIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Windows標準スタイル（既存） -->
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="MinHeight" Value="23"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        
        <Style TargetType="ToolBar">
            <Setter Property="ToolBarTray.IsLocked" Value="True"/>
        </Style>
    </Application.Resources>
</Application>